overpass.yourdomain.com {
	# Caddy handles ACME/HTTPS automatically for this domain once DNS
	# points at the droplet's IP — no manual cert setup needed.
	reverse_proxy overpass:80

	# The app calls this from the browser (Netlify origin), so it needs
	# CORS headers, same as the public Overpass mirrors provide.
	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, OPTIONS"
}
