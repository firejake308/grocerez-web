# Copy to .env for local development. In Docker Compose these come from the
# environment block instead.

PORT=8787
DATABASE_PATH=./data/grocerez.db

# Comma-separated list of origins allowed to call this API (the Netlify
# client's URL, plus localhost for dev). In production:
# CORS_ORIGINS=https://grocerez.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Also allow deploy-preview/branch-deploy URLs for this Netlify site (each
# one gets its own generated subdomain, so a fixed CORS_ORIGINS entry can't
# cover them). Find the slug in Netlify's site settings -- it's the part
# before ".netlify.app" in the site's default domain, e.g.
# "imaginative-sorbet-554b69" from imaginative-sorbet-554b69.netlify.app.
# Empty disables this.
NETLIFY_SITE_SLUG=

# Shared secret for the admin CLI/endpoints (section 9.5 of the plan).
ADMIN_TOKEN=change-me

# Email delivery for sign-in codes (section 6.1). "console" prints the code
# to the server log instead of sending an email -- use it for local dev.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=GrocerEZ <noreply@example.com>

# Geo proxy (section 8.6). Point at your own Overpass instance once it is
# running; the public Nominatim endpoint is fine at this scale.
OVERPASS_URL=http://localhost:12345/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Public free tier vs. paid subscription (section 6.3). Off by default so
# seed/dev users see everything; turn on once Stripe is configured below.
ENTITLEMENTS_ENFORCED=false

# AI parse proxy (Phase 3). Empty key -> /api/parse returns mock data
# instead of calling OpenRouter, same as the old client-side DEV mock.
OPENROUTER_API_KEY=
# Rough $/1K-token estimate used only for the daily spend cap below; not
# real billing data.
OPENROUTER_CENTS_PER_1K_TOKENS=0.2
PARSE_DAILY_BUDGET_CENTS=500

# Stripe subscriptions ($1.99/month). See "Turning on subscriptions" in
# server/README.md. Empty STRIPE_API_KEY disables checkout (503), same
# pattern as ADMIN_TOKEN above. The key is a SECRET: keep it only in this
# (gitignored) file on the server, never in the repo. A restricted
# rk_live_ key is best.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# The recurring $1.99 USD price made once in the Stripe dashboard. Not a
# secret, but the server refuses to check out if it is any other amount.
STRIPE_PRICE_ID=
# Where Stripe redirects after checkout. In production: https://grocerez.app
APP_URL=http://localhost:5173

# Photo evidence (Phase 3): downscaled price-tag photos, keyed by report id.
PHOTO_DIR=./data/photos

# --- Dev API (docker compose --profile dev) ----------------------------------
# Only read by the `api-dev` service on the VPS; ignored otherwise. Use Stripe
# TEST-mode values here, never live ones. See "Dev API on the VPS" in README.md.
# Leave NETLIFY_SITE_SLUG (above) empty so production never accepts previews.
DEV_NETLIFY_SITE_SLUG=
DEV_CORS_ORIGINS=http://localhost:5173
DEV_ADMIN_TOKEN=
DEV_STRIPE_API_KEY=
DEV_STRIPE_PRICE_ID=
DEV_STRIPE_WEBHOOK_SECRET=
# Where Stripe test checkouts return to: a stable Netlify branch-deploy URL.
DEV_APP_URL=http://localhost:5173
DEV_ENTITLEMENTS_ENFORCED=true
# Optional; empty returns mock parse results instead of calling OpenRouter.
DEV_OPENROUTER_API_KEY=
