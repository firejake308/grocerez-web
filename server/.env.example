# Copy to .env for local development. In Docker Compose these come from the
# environment block instead.

PORT=8787
DATABASE_PATH=./data/grocerez.db

# Comma-separated list of origins allowed to call this API (the Netlify
# client's URL, plus localhost for dev).
CORS_ORIGINS=http://localhost:5173

# Shared secret for the admin CLI/endpoints (section 9.5 of the plan).
ADMIN_TOKEN=change-me

# Email delivery for sign-in codes (section 6.1). "console" prints the code
# to the server log instead of sending an email -- use it for local dev.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=GrocerEZ <noreply@example.com>

# Geo proxy (section 8.6). Point at your own Overpass instance once it is
# running; the public Nominatim endpoint is fine at this scale.
OVERPASS_URL=http://localhost:12345/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Phase 3, not yet used ---
# OPENROUTER_API_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# PHOTO_DIR=./data/photos
